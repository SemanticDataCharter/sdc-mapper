  "@type": "DataModel",
  "@id": "sdc4:dm-jkuyr38hydqaiwlq5vhp2rjr",
  "identifier": "jkuyr38hydqaiwlq5vhp2rjr",
  "label": "Credit Note",
  "description": "A credit note as a governed record: the document header with its type, due date and currencies, the discrepancy it resolves, the order, the invoice credited, the dispatch advice and the receipt advice it refers to, the parties by role in one shape with the payee and the tax representative, the delivery, the payment means and terms, the allowances and charges, the tax and withholding tax totals, the legal monetary total, and the lines with the quantity credited, the amounts exclusive and inclusive of tax and the discrepancy each resolves; with its provenance, audit event and the Business Document Audit, and the order workflow bound. The concepts are the OASIS Universal Business Language 2.3 common library, composed on the Default and ProvGov libraries. A conformant UBL CreditNote is a projection of this record.",
  "metadata": {
    "dc:title": "Credit Note",
    "dc:creator": "Timothy Cook",
    "dc:subject": "credit note; billing; business document; supply chain",
    "dc:description": "A credit note as a governed record: the document header with its type, due date and currencies, the discrepancy it resolves, the order, the invoice credited, the dispatch advice and the receipt advice it refers to, the parties by role in one shape with the payee and the tax representative, the delivery, the payment means and terms, the allowances and charges, the tax and withholding tax totals, the legal monetary total, and the lines with the quantity credited, the amounts exclusive and inclusive of tax and the discrepancy each resolves; with its provenance, audit event and the Business Document Audit, and the order workflow bound. The concepts are the OASIS Universal Business Language 2.3 common library, composed on the Default and ProvGov libraries. A conformant UBL CreditNote is a projection of this record.",
    "dc:rights": "CC-BY http://creativecommons.org/licenses/by/3.0/",
    "dc:language": "en-US",
    "dc:format": "text/xml",
    "dc:date": "2026-10-01T10:50:23.074703+00:00"
  },
